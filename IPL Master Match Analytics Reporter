import pandas as pd
import os
from IPython.display import HTML, display
try:
    from google.colab import files
    print("Running on Google Colab. Please upload your CSV:")
    uploaded = files.upload()
    file_name = list(uploaded.keys())[0]
    is_colab = True
except ImportError:
    #change your file name
    file_name = '1491737.csv' 
    is_colab = False
    if not os.path.exists(file_name):
        print(f"Error: {file_name} not found in your local folder!")
        raise FileNotFoundError
try:
    metadata, ball_rows = {}, []
    with open(file_name, 'r', encoding='utf-8') as f:
        for line in f:
            parts = [p.strip() for p in line.split(',')]
            if parts[0] == 'info': metadata[parts[1]] = parts[2]
            elif parts[0] == 'ball' and len(parts) > 10: ball_rows.append(parts)
    df = pd.DataFrame(ball_rows)
    df.columns = [f"col_{i}" for i in range(len(df.columns))]
    df['runs'] = pd.to_numeric(df['col_7'], errors='coerce').fillna(0)
    df['is_wicket'] = df['col_14'].apply(lambda x: 1 if str(x) != 'nan' and str(x) != '' else 0)
    t1, t2 = df[df['col_1'] == '1']['col_3'].unique()[0], df[df['col_1'] == '2']['col_3'].unique()[0]
    winner = metadata.get('winner', t1)
    runner = t2 if winner == t1 else t1
    stadium = metadata.get('venue', 'Unknown Stadium')
    html_start = f"""
    <html><head><style>
        body {{ font-family: 'Segoe UI', Arial, sans-serif; background: #f0f2f5; padding: 30px; }}
        .report-card {{ background: white; max-width: 900px; margin: auto; padding: 40px; border-radius: 15px; box-shadow: 0 4px 20px rgba(0,0,0,0.15); }}
        .main-title {{ color: #1a237e; text-align: center; border-bottom: 5px solid #1a237e; padding-bottom: 15px; margin-bottom: 5px; }}
        .stadium-name {{ text-align: center; color: #555; font-size: 1.3em; margin-bottom: 25px; font-weight: bold; }}
        .summary-box {{ background: #e8eaf6; padding: 20px; border-radius: 10px; border-left: 10px solid #3f51b5; margin-bottom: 30px; }}
        table {{ width: 100%; border-collapse: collapse; margin-bottom: 25px; }}
        th {{ background: #3f51b5; color: white; padding: 12px; text-align: left; }}
        td {{ border: 1px solid #ddd; padding: 10px; }}
        tr:nth-child(even) {{ background: #f9f9f9; }}
        .won-title {{ color: #2e7d32; border-bottom: 2px solid #2e7d32; }}
        .lost-title {{ color: #d32f2f; border-bottom: 2px solid #d32f2f; }}
    </style></head><body><div class="report-card">
        <h1 class="main-title">IPL MATCH OFFICIAL REPORT</h1>
        <div class="stadium-name">{stadium.upper()}</div>
        <p align="center"><b>Match Date:</b> {metadata.get('date', '2026')}</p>
        <div class="summary-box">
            <p><b>Winner:</b> {winner} | <b>Runner:</b> {runner}</p>
            <p><b>Toss:</b> {metadata.get('toss_winner')} ({metadata.get('toss_decision')})</p>
            <p><b>Player of the Match:</b> {metadata.get('player_of_match')}</p>
        </div>
    """
    def create_team_tables(team, opp, label, css_cls):
        bat = df[df['col_3'] == team].groupby('col_4').agg(R=('runs','sum'), B=('col_4','count')).sort_values('R', ascending=False)
        bat_rows = "".join([f"<tr><td>{p}</td><td>{int(r['R'])}</td><td>{r['B']}</td></tr>" for p, r in bat.iterrows()])
        bowl = df[df['col_3'] == opp].groupby('col_6').agg(W=('is_wicket','sum'), R=('runs','sum')).sort_values('W', ascending=False)
        bowl_rows = "".join([f"<tr><td>{p}</td><td>{int(r['W'])}</td><td>{int(r['R'])}</td></tr>" for p, r in bowl.iterrows()])
        return f"""
        <h2 class="{css_cls}">{label}: {team.upper()}</h2>
        <h3>Batting Scorecard</h3>
        <table><tr><th>Batsman</th><th>Runs Scored</th><th>Balls</th></tr>{bat_rows}</table>
        <h3>Bowling Scorecard</h3>
        <table><tr><th>Bowler</th><th>Wickets</th><th>Runs Given</th></tr>{bowl_rows}</table>
        """
    html_body = create_team_tables(winner, runner, "WON TEAM", "won-title")
    html_body += create_team_tables(runner, winner, "RUNNERS", "lost-title")
    final_html = html_start + html_body + "</div></body></html>"
    output_file = "IPL_Match_Report_2026.html"
    with open(output_file, "w", encoding='utf-8') as f:
        f.write(final_html)
    if is_colab:
        files.download(output_file)
        print(f"SUCCESS! Report '{output_file}' is downloading.")
    else:
        import webbrowser
        abs_path = os.path.abspath(output_file)
        print(f"SUCCESS! Report saved at: {abs_path}")
        display(HTML(f'<h3><a href="{output_file}" target="_blank">👉 CLICK HERE TO OPEN REPORT 👈</a></h3>'))
        webbrowser.open(f'file://{abs_path}')
except Exception as e:
    print(f"Error processing report: {e}")
