import pandas as pd
import os
from IPython.display import HTML, display
try:
    from google.colab import files
    uploaded = files.upload()
    file_name = list(uploaded.keys())[0]
    is_colab = True
except ImportError:
    file_name = '1491737.csv' #change your file name here
    is_colab = False
try:
    metadata, ball_rows = {}, []
    with open(file_name, 'r', encoding='utf-8') as f:
        for line in f:
            parts = [p.strip() for p in line.split(',')]
            if parts[0] == 'info': metadata[parts[1]] = parts[2]
            elif parts[0] == 'ball' and len(parts) > 10: ball_rows.append(parts)
    df = pd.DataFrame(ball_rows)
    df.columns = [f"col_{i}" for i in range(len(df.columns))]
    df['runs'] = pd.to_numeric(df['col_7'], errors='coerce').fillna(0)
    df['is_wicket'] = df['col_14'].apply(lambda x: 1 if str(x) != 'nan' and str(x) != '' else 0)
    t1, t2 = df[df['col_1'] == '1']['col_3'].unique()[0], df[df['col_1'] == '2']['col_3'].unique()[0]
    winner = metadata.get('winner', t1)
    runner = t2 if winner == t1 else t1
    bat = df.groupby(['col_4', 'col_3']).agg(R=('runs','sum')).reset_index().rename(columns={'col_4':'P', 'col_3':'T'})
    bowl = df.groupby(['col_6', 'col_3']).agg(W=('is_wicket','sum')).reset_index().rename(columns={'col_6':'P', 'col_3':'T'})
    stats = pd.merge(bat, bowl, on=['P', 'T'], how='outer').fillna(0)
    stats['Score'] = stats['R'] + (stats['W'] * 20)
    stats = stats.sort_values('Score', ascending=False)
    def get_rows(data, count=3):
        return "".join([f"<tr><td>{r['P']}</td><td>{int(r['R'])}</td><td>{int(r['W'])}</td></tr>" for _, r in data.head(count).iterrows()])
    overall_stars = get_rows(stats)
    winner_stars = get_rows(stats[stats['T'] == winner])
    runner_stars = get_rows(stats[stats['T'] == runner])
    html_report = f"""
    <html><head><style>
        body {{ font-family: sans-serif; background: #f4f7f6; padding: 20px; }}
        .box {{ background: white; max-width: 900px; margin: auto; padding: 30px; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }}
        h1, h2 {{ text-align: center; color: #1a237e; border-bottom: 2px solid #eee; padding-bottom: 10px; }}
        .grid {{ display: flex; gap: 20px; margin-top: 20px; flex-wrap: wrap; }}
        .star-card {{ flex: 1; min-width: 250px; background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 15px; }}
        .overall {{ border-top: 5px solid #ffca28; background: #fffde7; }}
        .win-card {{ border-top: 5px solid #4caf50; }}
        .run-card {{ border-top: 5px solid #f44336; }}
        table {{ width: 100%; border-collapse: collapse; font-size: 13px; }}
        th {{ text-align: left; padding: 8px; background: #f8f9fa; border-bottom: 2px solid #ddd; }}
        td {{ padding: 8px; border-bottom: 1px solid #eee; }}
    </style></head><body><div class="box">
        <h1>IPL PERFORMANCE REPORT</h1>
        <p align="center"><b>Venue:</b> {metadata.get('venue')} | <b>Winner:</b> {winner}</p>
        
        <h2>🌟 MATCH TOP PERFORMERS 🌟</h2>
        <div class="grid">
            <div class="star-card overall">
                <h3 align="center">🏆 Overall Top 3</h3>
                <table><tr><th>Player</th><th>Runs</th><th>Wkts</th></tr>{overall_stars}</table>
            </div>
            <div class="star-card win-card">
                <h3 align="center">✅ {winner} Stars</h3>
                <table><tr><th>Player</th><th>Runs</th><th>Wkts</th></tr>{winner_stars}</table>
            </div>
            <div class="star-card run-card">
                <h3 align="center">❌ {runner} Stars</h3>
                <table><tr><th>Player</th><th>Runs</th><th>Wkts</th></tr>{runner_stars}</table>
            </div>
        </div>
    """
    def create_table(team, opp, title, color):
        b = df[df['col_3']==team].groupby('col_4').agg(R=('runs','sum'), B=('col_4','count')).sort_values('R', ascending=False)
        w = df[df['col_3']==opp].groupby('col_6').agg(W=('is_wicket','sum'), R=('runs','sum')).sort_values('W', ascending=False)
        return f'<h2 style="color:{color}">{title}: {team}</h2><h3>Batting</h3><table><tr><th>Bat</th><th>Runs</th><th>Balls</th></tr>' + \
               "".join([f"<tr><td>{p}</td><td>{int(r['R'])}</td><td>{r['B']}</td></tr>" for p, r in b.iterrows()]) + \
               '</table><h3>Bowling</h3><table><tr><th>Bowl</th><th>Wkts</th><th>Runs</th></tr>' + \
               "".join([f"<tr><td>{p}</td><td>{int(r['W'])}</td><td>{int(r['R'])}</td></tr>" for p, r in w.iterrows()]) + '</table>'
    html_report += create_table(winner, runner, "WINNING TEAM", "green") + create_table(runner, winner, "RUNNER TEAM", "red") + "</div></body></html>"
    with open("IPL_Triple_Star_Report.html", "w", encoding='utf-8') as f: f.write(html_report)
    if is_colab: files.download("IPL_Triple_Star_Report.html")
    else: display(HTML('<h3>Report Ready! Open "IPL_Triple_Star_Report.html" in your folder.</h3>'))
except Exception as e: print(f"Error: {e}")
