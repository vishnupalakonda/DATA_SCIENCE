import pandas as pd
from fpdf import FPDF
from google.colab import files
import os
print("Upload your IPL CSV File:")
uploaded = files.upload()
file_name = list(uploaded.keys())[0]
try:
    metadata = {}
    ball_rows = []
    with open(file_name, 'r') as f:
        for line in f:
            parts = [p.strip() for p in line.split(',')]
            if parts[0] == 'info':
                metadata[parts[1]] = parts[2]
            elif parts[0] == 'ball' and len(parts) > 10:
                ball_rows.append(parts)
    df = pd.DataFrame(ball_rows)
    df.columns = [f"col_{i}" for i in range(len(df.columns))]
    df['runs'] = pd.to_numeric(df['col_7'], errors='coerce').fillna(0)
    df['is_wicket'] = df['col_14'].apply(lambda x: 1 if str(x) != 'nan' and str(x) != '' else 0)
    team1 = df[df['col_1'] == '1']['col_3'].unique()[0]
    team2 = df[df['col_1'] == '2']['col_3'].unique()[0]
    winner_name = metadata.get('winner', team1)
    runner_name = team2 if winner_name == team1 else team1
    stadium_name = metadata.get('venue', 'Unknown Stadium')
    pdf = FPDF()
    pdf.set_auto_page_break(auto=True, margin=15)
    pdf.add_page()
    pdf.set_font("Arial", 'B', 32)
    pdf.set_text_color(220, 20, 60) # Red
    pdf.cell(0, 40, "IPL MATCH REPORT", ln=True, align='C')
    pdf.set_text_color(0, 0, 0)
    pdf.set_font("Arial", 'B', 18)
    pdf.cell(0, 10, f"STADIUM: {stadium_name.upper()}", ln=True, align='C')
    pdf.set_font("Arial", '', 14)
    pdf.cell(0, 10, f"DATE: {metadata.get('date', '2026')}", ln=True, align='C')
    pdf.ln(20)
    pdf.set_font("Arial", 'B', 14)
    pdf.set_fill_color(240, 240, 240)
    pdf.cell(0, 12, " OFFICIAL SUMMARY", ln=True, fill=True)
    pdf.set_font("Arial", '', 12)
    pdf.cell(0, 10, f"- MATCH: {team1} vs {team2}", ln=True)
    pdf.cell(0, 10, f"- PLAYER OF THE MATCH: {metadata.get('player_of_match', 'N/A')}", ln=True)
    pdf.cell(0, 10, f"- RESULT: {winner_name.upper()} WON", ln=True)
    def add_team_stats(team, opp, label, color):
        pdf.add_page()
        pdf.set_text_color(*color)
        pdf.set_font("Arial", 'B', 24)
        pdf.cell(0, 20, f"{label}: {team.upper()}", ln=True, align='C')
        pdf.set_text_color(0, 0, 0)
        pdf.set_font("Arial", 'B', 14)
        pdf.set_fill_color(245, 245, 245)
        pdf.cell(0, 10, " BATTING REPORT", ln=True, fill=True)
        pdf.set_font("Arial", 'B', 10)
        pdf.cell(90, 8, "BATSMAN", 1); pdf.cell(45, 8, "RUNS", 1); pdf.cell(45, 8, "BALLS", 1, ln=True)
        pdf.set_font("Arial", '', 10)
        bat_stats = df[df['col_3'] == team].groupby('col_4').agg(R=('runs','sum'), B=('col_4','count')).sort_values('R', ascending=False)
        for p, row in bat_stats.iterrows():
            pdf.cell(90, 8, str(p), 1); pdf.cell(45, 8, str(int(row['R'])), 1); pdf.cell(45, 8, str(row['B']), 1, ln=True)
        pdf.ln(10)
        pdf.set_font("Arial", 'B', 14)
        pdf.cell(0, 10, " BOWLING REPORT", ln=True, fill=True)
        pdf.set_font("Arial", 'B', 10)
        pdf.cell(90, 8, "BOWLER", 1); pdf.cell(45, 8, "WICKETS", 1); pdf.cell(45, 8, "RUNS GIVEN", 1, ln=True)
        pdf.set_font("Arial", '', 10)
        bowl_stats = df[df['col_3'] == opp].groupby('col_6').agg(W=('is_wicket','sum'), R=('runs','sum')).sort_values('W', ascending=False)
        for p, row in bowl_stats.iterrows():
            pdf.cell(90, 8, str(p), 1); pdf.cell(45, 8, str(int(row['W'])), 1); pdf.cell(45, 8, str(int(row['R'])), 1, ln=True)
    add_team_stats(winner_name, runner_name, "WINNERS TEAM", (34, 139, 34))
    add_team_stats(runner_name, winner_name, "RUNNERS TEAM", (178, 34, 34))
    final_name = "IPL_Match_Report_2026.pdf"
    pdf.output(final_name)
    if os.path.exists(final_name):
        files.download(final_name)
        print(f"SUCCESS! Report saved as {final_name}")
    else:
        print("Error: PDF creation failed.")
except Exception as e:
    print(f"Error: {e}")
